package cinnabar:experience-server@0.12.0;

interface types {
    record block-pos { x: s32, y: s32, z: s32 }
    enum face { down, up, north, south, west, east }
    /// Canonical lowercase hyphenated UUID; an opaque identity, not a credential.
    type player-id = string;
    enum log-level { debug, info, warn, error }
    enum world-error {
        denied, unavailable, out-of-bounds, unknown-block, unsupported-state,
        not-owned, too-large, quota-exceeded, player-unavailable, invalid-text,
    }
    variant guest-error { rejected(string), failed(string) }
    /// slot is "*", "up", "down", "north", "south", "east" or "west"; path is under assets/.
    record texture-binding { slot: string, path: string }
    variant mining { unbreakable, breakable(f32) }
    record block-def { id: string, display-name: string, textures: list<texture-binding>, mining: mining }
    record callback-info { world-id: string, dimension-id: string, tick: u64, event-sequence: u64 }
    enum change-cause { player, guest, environment }
    record block-change {
        pos: block-pos, actor: option<player-id>, cause: change-cause,
        before-id: string, after-id: string, previous-data: option<list<u8>>,
    }
    /// One leaf value of a client-channel record, as the client part's channel declares it.
    variant scalar { %bool(bool), integer(s64), text(string), choice(u16) }
    /// One node of a client-channel record. WIT types cannot nest, so a record travels as its
    /// values in pre-order: a scalar is a leaf, and a list or record value is a header holding
    /// its item count, followed by that many values, each a leaf or another header with its own
    /// items. The values left after a value's items are the record's next fields.
    variant value-node { leaf(scalar), %list(u32), %record(u32) }

    // 0.5: block states and visuals, items and the player's inventory, and the network scope.
    // Every 0.4 type above is unchanged, so the 0.4 world shares them.

    /// A point in a block, in pixels: 0 to 16 on each axis, x east, y up, z south.
    record pixel { x: f32, y: f32, z: f32 }
    /// An axis-aligned box in a block, in pixels (`minecraft:collision_box`,
    /// `minecraft:selection_box`).
    record pixel-box { min: pixel, max: pixel }
    /// How a material draws (`minecraft:material_instances` `render_method`).
    enum render-method { opaque, alpha-test, blend, double-sided }
    /// A texture animated as a vertical strip of square frames (`flipbook_textures.json`):
    /// `frames` index the strip in play order, each shown for `ticks-per-frame`.
    record flipbook { ticks-per-frame: u32, frames: list<u32>, blend-frames: bool }
    /// One material instance: `instance` is "*", a face name, or an instance the geometry's faces
    /// name; `path` is a PNG under assets/.
    record material { instance: string, path: string, render-method: render-method, flipbook: option<flipbook> }
    /// The values one state takes: a bool, or 1 to 16 strings.
    variant state-values { %bool, choices(list<string>) }
    /// A state a block declares; its name is namespaced by the Experience id.
    record state-def { name: string, values: state-values }
    /// One state's value.
    variant state-value { %bool(bool), choice(string) }
    /// A state and its value.
    record block-state { name: string, value: state-value }
    /// Bedrock's placement traits a block takes. Each adds its states, which the server sets when
    /// the block is placed by the trait's rule: `minecraft:cardinal_direction` and
    /// `minecraft:facing_direction` (`minecraft:placement_direction`),
    /// `minecraft:block_face` and `minecraft:vertical_half` (`minecraft:placement_position`).
    flags placement-states { cardinal-direction, facing-direction, block-face, vertical-half }
    /// `state == value` when `equal`, else `state != value`.
    record state-test { state: block-state, equal: bool }
    /// True when any of its lists has only passing tests: an or of ands. An empty outer list is
    /// never true; an empty inner list always is.
    type condition = list<list<state-test>>;
    /// Quarter turns about each axis, 0 to 3, applied x then y then z
    /// (`minecraft:transformation`).
    record quarter-turns { x: u8, y: u8, z: u8 }
    /// A geometry bone that draws only while `visible` holds (`bone_visibility`).
    record bone-visibility { bone: string, visible: condition }
    /// What a block looks like. `geometry` is a `.geo.json` under assets/ holding one geometry
    /// identified `geometry.<experience id>.<name>`; none is the full cube. `bones` name
    /// bones of that geometry. Boxes default to the full cube.
    record visual {
        geometry: option<string>, materials: list<material>, bones: list<bone-visibility>,
        collision: option<pixel-box>, selection: option<pixel-box>, rotation: option<quarter-turns>,
    }
    /// While `when` holds, each part it sets replaces the visual's; of several that hold, a later
    /// one wins. A geometry brings its own bones.
    record permutation {
        when: condition, geometry: option<string>, materials: option<list<material>>,
        bones: option<list<bone-visibility>>, collision: option<pixel-box>,
        selection: option<pixel-box>, rotation: option<quarter-turns>,
    }
    /// A block of 0.5: its 0.4 definition, its states and placement traits, its look, and whether
    /// it is a member of networks (`callback.network`). With a `visual`, `def.textures` is empty.
    record block-type {
        def: block-def, states: list<state-def>, placement: placement-states,
        visual: option<visual>, permutations: list<permutation>, network: bool,
    }
    /// An item of this Experience, in its creative group; `icon` is a PNG under assets/.
    record item-def { id: string, display-name: string, icon: string, max-stack: u8 }
    /// What `register` declares.
    record registration { blocks: list<block-type>, items: list<item-def> }
    /// An item stack: its Bedrock id and metadata, count and the most one stack holds. `data` is
    /// only on this Experience's items. `plain` when the stack carries nothing else (no
    /// enchantments, name, damage or other data).
    record item-stack { id: string, metadata: u16, count: u8, max-count: u8, data: option<list<u8>>, plain: bool }
    /// A stack the guest puts somewhere: a plain vanilla item, or this Experience's with its data.
    record new-stack { id: string, metadata: u16, count: u8, data: option<list<u8>> }
    /// A player's inventory: `slots` 0 to 8 the hotbar, 9 to 35 the rest of the main inventory,
    /// 36 the offhand; `selected` the hotbar slot in hand.
    record inventory { selected: u8, slots: list<option<item-stack>> }
    /// The network around a callback's anchor: every loaded member reachable through
    /// face-adjacent members. `truncated` when its bounds cut it short.
    record network { blocks: list<block-pos>, truncated: bool }

    // 0.6: the server's crafting recipes and scheduled updates. Every 0.5 type above is
    // unchanged, so the 0.5 world shares them.


    /// A registered definition, distinct from a live instance and its dimension type.
    record world-definition-id { value: string }
    /// Stable storage identity. Names are scoped to the installing Experience.
    record world-instance-id { value: string }
    /// One opening of an instance; unloading or reopening invalidates earlier handles.
    record world-handle { id: world-instance-id, generation: u64 }
    /// Built-in environment profiles, including their height and sky rules.
    enum dimension-type { overworld, nether, end }
    enum generator { empty, flat }
    record world-settings { generator: generator, dimension: dimension-type, persistent: bool }
    record world-definition { id: world-definition-id, settings: world-settings }
    record world-instance { id: world-instance-id, definition: world-definition-id }
    record world-registration { definitions: list<world-definition>, startup: list<world-instance> }
    record position { x: f64, y: f64, z: f64 }
    /// An entity definition from the generated shared declarations.
    record entity-type-id { value: string }
    /// An entity identity reserved by the callback; its generation belongs to a world opening.
    record entity-handle { id: u64, generation: u64 }
    record entity-rotation { yaw: f64, pitch: f64 }
    /// A centered square at the feet; width and height must fit positive f32 values.
    record entity-box { min: position, max: position }
    record entity-seat { position: position, rotation-limit: option<f64>, steers: bool }
    /// Pack-relative assets become validated files in the generated server resource pack.
    record entity-art { geometry: string, texture: string, render-controller: string }
    variant entity-appearance { vanilla(entity-type-id), custom(entity-art) }
    record entity-property-id { value: string }
    record entity-property-def { id: entity-property-id, min: f32, max: f32, initial: f32 }
    record entity-property { id: entity-property-id, value: f32 }
    record entity-definition {
        id: entity-type-id, collision: entity-box, appearance: entity-appearance,
        seats: list<entity-seat>, properties: list<entity-property-def>,
    }
    record entity-state {
        handle: entity-handle, kind: entity-type-id, position: position,
        rotation: entity-rotation, velocity: position, name-tag: string, scale: f32,
        %variant: s32, properties: list<entity-property>,
    }
    enum entity-hand { main, off }
    record entity-interaction { player: player-id, hand: entity-hand, item: option<item-stack> }
    record entity-rider { player: player-id, seat: u32 }
    record entity-input { rider: entity-rider, sideways: f32, forward: f32, yaw: f64, pitch: f64, jump: bool, sneak: bool }
    variant entity-event {
        interact(entity-interaction), attacked(entity-interaction), mounted(entity-rider),
        dismounted(entity-rider), steering(entity-input), despawned,
    }
    record player-location { %world: world-handle, epoch: u64, position: position }
    record player-transition { before: player-location, after: player-location }
    variant player-event { join(player-location), leave(player-location), world-change(player-transition), move(player-transition) }
    /// Scope is restricted to this callback's player, world instance, or installing mod.
    enum store-scope { player, instance, mod }
    /// Schema revisions are part of a key; changing a type requires an explicit migration.
    record store-key { scope: store-scope, schema: u32 }

    /// A cancellable callback scoped to one instance opening and installing mod.
    record schedule-handle { %world: world-handle, sequence: u64, slot: u32 }
    record simulation-step { tick: u64, duration-nanos: u64 }

    /// An item by Bedrock id and metadata.
    record item-key { id: string, metadata: u16 }
    /// What a crafting recipe makes.
    record crafted { id: string, metadata: u16, count: u8 }

    // 0.10: cell overlays. Every type above is unchanged, so the older worlds share them.

    /// A look drawn in an overlay host's cell, never a block of the world: it has no item or
    /// collision and is never placed or broken alone. Its name follows the block-name rule and
    /// shares the blocks' namespace, so its id is `<experience id>:<name>`, which no block of the
    /// Experience has. Its visual is authored with its front out of north (-z) and its top up;
    /// an overlay turns it to its face. Its selection box, from the visual or the permutation
    /// that sets one last, is what picks it; without one it is never picked. Its collision box
    /// is ignored.
    record overlay-type { name: string, states: list<state-def>, visual: visual, permutations: list<permutation> }
    /// What `overlays` declares: the ids of this Experience's blocks that may carry overlays,
    /// and its overlay types.
    record overlay-registration { hosts: list<string>, types: list<overlay-type> }
    /// One of this Experience's overlay types, by id, in these states; a state it does not name
    /// takes its first value.
    record overlay-visual { kind: string, states: list<block-state> }
    /// An item drawn flat on the face as an inventory slot shows it, lit at full brightness and
    /// never picked: `size` is its edge and `x` and `y` its centre, in pixels from the face's
    /// centre, x to the right and y up as one looks at the face.
    record overlay-item { item: item-key, size: f32, x: f32, y: f32 }
    /// What an overlay draws.
    variant overlay-look { visual(overlay-visual), item(overlay-item) }
    /// One overlay of a cell: its slot, 0 to 11 and unique in the cell (overlays draw and are
    /// picked in slot order), the face it turns to, and what it draws.
    record overlay { slot: u8, face: face, look: overlay-look }

    // 0.12: what a block drops, how its item is offered, whether it takes part in redstone, and
    // a player's game mode. Every type above is unchanged, so the older worlds share them.

    /// What breaking a block drops by itself: `itself`, its own item, as a plain block does, or
    /// `nothing`, which leaves every drop to the guest's `on-break`.
    enum block-drops { itself, nothing }
    /// A block's item: `listed` in the Experience's creative group, as a plain block's is;
    /// `unlisted`, an item held, placed and dropped like any other that the creative inventory
    /// leaves out; or `none`, no item at all, so the block is never held, picked or dropped as
    /// itself and no stack of it can be made.
    enum block-item { listed, unlisted, none }
    /// The drops and item of one of the Experience's blocks, by id, and whether it takes part in
    /// redstone: a `redstone` block receives power (`callback.redstone-power`), emits what its
    /// callbacks set (`callback.set-redstone-power`), and gets `on-neighbor-changed` with its own
    /// position as `neighbor` when the power it receives changes. Redstone dust connects only to
    /// the Experience's `redstone` blocks.
    record block-rule { block: string, drops: block-drops, item: block-item, redstone: bool }
    /// What `content-rules` declares: rules for some of the Experience's blocks, each named once,
    /// and the ids of its items that the creative inventory leaves out. A block without a rule
    /// drops itself and has a listed item; a block without an item cannot drop itself.
    record content-rules { blocks: list<block-rule>, unlisted-items: list<string> }
    /// A player's game mode, read from what the mode allows, so a server's variant of one plays
    /// as it: `spectator` passes through blocks, `creative` has the creative inventory,
    /// `adventure` cannot edit the world, and `survival` is every other mode.
    enum game-mode { survival, creative, adventure, spectator }
}

interface world-access {
    use types.{
        block-pos, player-id, callback-info, world-error, value-node, block-state, network,
        inventory, new-stack, item-key, crafted, world-handle, world-instance, world-instance-id,
        player-location, position, store-key, simulation-step, schedule-handle, overlay,
        entity-type-id, entity-handle, entity-state, entity-rotation, item-stack, game-mode,
    };
    /// Created only by the host, for one callback invocation.
    resource callback {
        info: func() -> callback-info;
        /// Reads only this mod's entities in the current instance, with staged writes applied.
        entities: func() -> list<entity-state>;
        spawn-entity: func(kind: entity-type-id, position: position, rotation: entity-rotation) -> result<entity-handle, world-error>;
        /// Server-driven movement interpolates unless teleport is true. Velocity is in blocks per tick.
        update-entity: func(state: entity-state, teleport: bool) -> result<_, world-error>;
        despawn-entity: func(handle: entity-handle) -> result<_, world-error>;
        /// Only the current actor may mount or dismount, in the current world opening.
        mount-entity: func(handle: entity-handle, seat: u32) -> result<_, world-error>;
        dismount-entity: func() -> result<_, world-error>;
        /// Fixed-step simulation time for this instance, independent of viewers.
        simulation: func() -> result<simulation-step, world-error>;
        /// Schedule relative to commit. A zero period runs once; otherwise it repeats.
        schedule: func(after: u32, period: u32) -> result<schedule-handle, world-error>;
        cancel-schedule: func(handle: schedule-handle) -> result<_, world-error>;
        /// The actual instance opening, independent of the legacy metadata in info.
        %world: func() -> world-handle;
        /// Only this callback's actor may be read. Leave events have no live player.
        player-location: func(player: player-id) -> result<player-location, world-error>;
        /// Resolves an instance owned by this Experience from this callback's snapshot.
        resolve-world: func(id: world-instance-id) -> result<world-handle, world-error>;
        /// Lifecycle operations must be the only staged operation. Results are observed by
        /// subsequent resolve-world/player events, after host validation and commit.
        create-world: func(instance: world-instance) -> result<_, world-error>;
        unload-world: func(instance: world-handle) -> result<_, world-error>;
        transfer: func(player: player-id, instance: world-handle, position: position) -> result<_, world-error>;
        /// Reads private state; none is absent, an empty list is a present empty value.
        store-read: func(key: store-key) -> result<option<list<u8>>, world-error>;
        /// Stages private state. none deletes it. Shares the block store's byte quota.
        store-write: func(key: store-key, data: option<list<u8>>) -> result<_, world-error>;
        get-block: func(pos: block-pos) -> result<string, world-error>;
        set-block: func(pos: block-pos, id: string) -> result<_, world-error>;
        block-data: func(pos: block-pos) -> result<option<list<u8>>, world-error>;
        /// none deletes the record.
        set-block-data: func(pos: block-pos, data: option<list<u8>>) -> result<_, world-error>;
        tell: func(player: player-id, text: string) -> result<_, world-error>;
        /// Stages `payload` for `player`'s client part on `channel`, revision `schema`. It is sent
        /// after the callback commits, if that player's client part declares the channel.
        send-client: func(player: player-id, channel: string, schema: u16, payload: list<value-node>) -> result<_, world-error>;
        /// Stages a negotiation or acknowledgment reply through retained control delivery.
        /// A newer reply on the same route replaces any pending one. Pending replies expire
        /// with the connection or world epoch; ordinary data should use send-client.
        send-control: func(player: player-id, channel: string, schema: u16, payload: list<value-node>) -> result<_, world-error>;
        /// The block that a `client-message` or `epoch` callback got as its player's focus: the
        /// block of this Experience that the player last used. Its snapshot is the one
        /// `on-interact` gets, the block and its neighbors, and it is read and written the same
        /// way. None when the player has no focus, or it is no longer valid: the block is gone or
        /// was replaced, is unloaded, or is in another dimension than the player or out of range.
        /// None in every other callback.
        focus: func() -> option<block-pos>;
        /// The states of the block at `pos`, with staged changes applied; read like `get-block`.
        block-states: func(pos: block-pos) -> result<list<block-state>, world-error>;
        /// Stages new values for some states of this Experience's block at `pos`, keeping its
        /// data and generation; states it does not name keep theirs. Written where
        /// `set-block-data` writes.
        set-block-state: func(pos: block-pos, states: list<block-state>) -> result<_, world-error>;
        /// The network the anchor belongs to; none when the anchor is not a network member.
        network: func() -> result<option<network>, world-error>;
        /// The actor's inventory as it was snapshotted, with staged slots applied;
        /// `player-unavailable` without an actor.
        inventory: func() -> result<inventory, world-error>;
        /// The actor's game mode as it was snapshotted with its inventory; `player-unavailable`
        /// without an actor.
        game-mode: func() -> result<game-mode, world-error>;
        /// Stages new content for one of the actor's inventory slots; none empties it.
        set-slot: func(slot: u32, stack: option<new-stack>) -> result<_, world-error>;
        /// Stages an item entity holding `stack`, spawned at `pos`, a position `set-block` may
        /// write.
        drop-item: func(pos: block-pos, stack: new-stack) -> result<_, world-error>;
        /// What the server's crafting-table recipes make of a 3×3 grid, row by row from the top
        /// left, one item or none per cell: the first shaped recipe the grid's items match, its
        /// shape anywhere in the grid or mirrored, or the first shapeless recipe whose inputs are
        /// exactly the grid's items. None when no recipe does, or the grid is not nine cells.
        crafting-result: func(grid: list<option<item-key>>) -> option<crafted>;
        /// Stages an update of this Experience's block at `pos`, a position `set-block-data` may
        /// write, `ticks` (1 or more) game ticks after the callback commits; it then gets
        /// `on-scheduled-update`. The server keeps scheduled updates across a restart.
        schedule-update: func(pos: block-pos, ticks: u32) -> result<_, world-error>;
        /// The overlays of the block at `pos` in slot order, with staged changes applied; read
        /// like `block-states`. Empty for a block without any.
        overlays: func(pos: block-pos) -> result<list<overlay>, world-error>;
        /// Stages the whole overlay list of this Experience's overlay host at `pos`, written
        /// where `set-block-state` writes; an empty list removes them all. The block keeps its
        /// states, data and generation, and its neighbors get no update. Restaging a cell
        /// replaces what was staged for it. `not-owned` for another's block; `unsupported-state`
        /// for a block that is not an overlay host, a slot above 11 or used twice, a state the
        /// overlay's type does not declare or a value it does not take, or an item's size, `x`
        /// or `y` that is not finite, a size outside 0 (exclusive) to 16, or a centre more than
        /// 8 pixels off the face's; `too-large` for more than 12 overlays; `unknown-block` for a
        /// kind that is not one of this Experience's overlay types, or an item that is neither
        /// the server's nor this Experience's.
        set-overlays: func(pos: block-pos, overlays: list<overlay>) -> result<_, world-error>;
        /// Whether this `on-break` is a harvest: its player broke the block in a game mode that
        /// drops what is broken, so the drops a block without its own (`block-drops.nothing`)
        /// leaves to the guest are due. False in creative and in every other callback.
        harvested: func() -> bool;
        /// Passes this `on-interact`'s click on instead of taking it, as a vanilla block with
        /// nothing to do with the click does: once the callback commits, the player's held item
        /// is used on the block as if it had no action, so a block item is placed against it and
        /// a bucket or flint and steel is used. Staged like a write, and kept only if the
        /// callback commits; nothing passes when the player holds another item by then. `denied`
        /// in every other callback.
        pass-interaction: func() -> result<_, world-error>;
        /// The slots of the container block at `pos`, in the container's own order, with staged
        /// changes applied: a chest (a double chest whole at either half), barrel, shulker box,
        /// hopper, furnace, blast furnace, smoker or brewing stand. A container is in reach when
        /// it is the anchor or a member of the anchor's network, or next to one of them:
        /// `denied` for a position out of reach, `out-of-bounds` outside the world's height,
        /// `unknown-block` for a block in reach that is no container, and `unavailable` for one
        /// in an unloaded chunk or one the snapshot left out once it held as many containers or
        /// as much of their item data as it may.
        container: func(pos: block-pos) -> result<list<option<item-stack>>, world-error>;
        /// Stages new content for slot `slot` of the container at `pos`, which `container`
        /// reads; none empties it. The stack is one the guest may make, as for `set-slot`, and
        /// the container takes it whatever its own rules for the slot. `out-of-bounds` for a
        /// slot the container lacks. A slot written again, through either half of a double
        /// chest, replaces its staged write, and the callback commits only if every container
        /// it writes still holds what its snapshot did.
        set-container-slot: func(pos: block-pos, slot: u32, stack: option<new-stack>) -> result<_, world-error>;
        /// The redstone power, 0 to 15, that this Experience's `redstone` block at `pos` receives
        /// from its neighbours, read like `block-states`: `not-owned` for another's block and
        /// `unsupported-state` for one of its blocks that is not `redstone`.
        redstone-power: func(pos: block-pos) -> result<u8, world-error>;
        /// Stages the redstone power, 0 to 15, that this Experience's `redstone` block at `pos`
        /// emits from every face, as a block of redstone does at 15: it powers the dust and
        /// mechanisms next to it, but not through the blocks next to it. Written where
        /// `set-block-state` writes; the block keeps its states, data and generation, and its
        /// power until a callback sets another or it is replaced. `not-owned` for another's
        /// block; `unsupported-state` for a block that is not `redstone` or a power above 15.
        set-redstone-power: func(pos: block-pos, power: u8) -> result<_, world-error>;
    }
}

interface diagnostics {
    use types.{log-level};
    log: func(level: log-level, text: string);
}

world server {
    import world-access;
    import diagnostics;
    use world-access.{callback};
    use types.{registration, block-change, block-pos, player-id, face, guest-error, value-node, world-registration, player-event, simulation-step, schedule-handle, entity-definition, entity-handle, entity-event, overlay-registration, pixel, content-rules};
    export entity-definitions: func() -> result<list<entity-definition>, guest-error>;
    export on-entity: func(ctx: borrow<callback>, handle: entity-handle, event: entity-event) -> result<_, guest-error>;
    /// Declares the Experience's world definitions and startup instances; it runs once, at startup.
    export world-definitions: func() -> result<world-registration, guest-error>;
    /// Declares the Experience's overlay hosts and overlay types; it runs once, at startup,
    /// after `register`.
    export overlays: func() -> result<overlay-registration, guest-error>;
    /// Declares how the Experience's blocks drop and offer their items, and which of its items
    /// the creative inventory leaves out; it runs once, at startup, after `register`.
    export content-rules: func() -> result<content-rules, guest-error>;
    /// Ordered observations. Move events retain the first and last position in one host tick.
    export on-player: func(ctx: borrow<callback>, player: player-id, event: player-event) -> result<_, guest-error>;
    /// One admitted simulation tick, followed by due scheduled callbacks in handle order.
    export on-tick: func(ctx: borrow<callback>, step: simulation-step) -> result<_, guest-error>;
    export on-timer: func(ctx: borrow<callback>, handle: schedule-handle, step: simulation-step) -> result<_, guest-error>;
    /// Declares the Experience's blocks and items; it runs once, at startup.
    export register: func() -> result<registration, guest-error>;
    export on-place: func(ctx: borrow<callback>, change: block-change) -> result<_, guest-error>;
    export on-break: func(ctx: borrow<callback>, change: block-change) -> result<_, guest-error>;
    /// `player` used the block at `pos`, clicking `clicked-face`. `hit` is where the click met
    /// the block, in pixels, when the client sent one within the cell. `target` is the slot of
    /// the block's first overlay, in slot order, whose turned selection box holds `hit` once
    /// grown by 0.032 pixels on each side; none without `hit` or when no overlay's box holds it.
    /// The block takes the click unless the callback passes it on (`callback.pass-interaction`).
    export on-interact: func(ctx: borrow<callback>, player: player-id, pos: block-pos, clicked-face: face, hit: option<pixel>, target: option<u8>) -> result<_, guest-error>;
    export on-neighbor-changed: func(ctx: borrow<callback>, pos: block-pos, neighbor: block-pos) -> result<_, guest-error>;
    /// `player`'s client part sent `payload` on `channel`, revision `schema`. `ctx` has the
    /// snapshot of `player`'s focus (`callback.focus`); without one, every world read and write
    /// is refused.
    export client-message: func(ctx: borrow<callback>, player: player-id, channel: string, schema: u16, payload: list<value-node>) -> result<_, guest-error>;
    /// `player`'s client part moved to a new world epoch and kept running, so it may have missed
    /// what was sent before. `ctx` has the snapshot of `player`'s focus (`callback.focus`);
    /// without one, every world read and write is refused.
    export epoch: func(ctx: borrow<callback>, player: player-id) -> result<_, guest-error>;
    /// An update `schedule-update` staged for this Experience's block at `pos` is due. `ctx` has
    /// the snapshot an interaction with that block would have.
    export on-scheduled-update: func(ctx: borrow<callback>, pos: block-pos) -> result<_, guest-error>;
}
