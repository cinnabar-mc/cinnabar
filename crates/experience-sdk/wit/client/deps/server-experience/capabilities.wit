package cinnabar:server-experience@1.7.0;

/// Host-owned JSON-UI widgets and the bundle's signed modal screens.
/// Player mods import this interface's types; its functions are available only to client parts.
/// Grants: The signed client bundle's `ui` permission for widgets and `modal_ui` for modal mutations; modal-size reads the current admitted modal.
interface ui {
    /// A value bound into a screen property, in the forms the JSON-UI engine's bindings read:
    /// `numbers` carries arrays such as a colour `[r, g, b, a]` or an offset `[x, y]`.
    variant value {
        boolean(bool),
        integer(s64),
        number(f64),
        text(string),
        numbers(list<f64>),
    }

    /// Sets one declared widget's plain text under this bundle's UI permission.
    set-widget: func(id: string, text: string) -> result<_, string>;
    /// Opens (or switches to) a template the manifest indexes under `templates`, as a modal
    /// over gameplay; `none` closes the modal.
    open-screen: func(template: option<string>) -> result<_, string>;
    /// Closes this bundle's modal screen without selecting another template.
    @since(version = 1.1.0)
    close-screen: func() -> result<_, string>;
    /// Replaces a collection's rows: a JSON array of objects mapping a `#binding` name to a value
    /// (`{"type":"bool|integer|number|text|numbers","value":…}`).
    @since(version = 1.1.0)
    set-collection: func(name: string, rows-json: list<u8>) -> result<_, string>;
    /// Binds one `#binding` name for the whole screen.
    @since(version = 1.1.0)
    set-value: func(name: string, value: value) -> result<_, string>;

    /// The size the open modal lays out in, as the vanilla screens' root does: `width` and
    /// `height` in GUI units, and `scale`, the window's logical pixels per GUI unit (the GUI
    /// scale).
    @since(version = 1.2.0)
    record gui-size {
        width: f64,
        height: f64,
        scale: f64,
    }

    /// This bundle's open modal's size, once it has been drawn; `none` while it is closed or not
    /// drawn yet. `modal-resized` reports each change.
    @since(version = 1.2.0)
    modal-size: func() -> option<gui-size>;
    /// Sets the text of the open modal's edit boxes (`text_edit_box`) whose `text_box_name` is
    /// `control`, as typing would leave it but cut to the box's `max_length`; it does not deliver
    /// `text-changed`. The text holds no control characters other than line breaks.
    @since(version = 1.2.0)
    set-text: func(control: string, text: string) -> result<_, string>;

    /// What a scroll view shows along its scrolling axis, in GUI units: how far its content is
    /// scrolled (`offset`, from 0 to `content` - `viewport`), the length of its viewport, and the
    /// length of its content.
    @since(version = 1.3.0)
    record scroll-range {
        offset: f64,
        viewport: f64,
        content: f64,
    }
}

/// Named actions, available only while the host grants focus.
/// Grants: The signed client bundle's `input` permission and host-owned focus.
interface input {
    /// Reports a named action edge only while the bundle owns host-granted focus.
    pressed: func(action: string) -> bool;
}

/// The host validates each record against its signed channel schema.
/// Grants: The signed client bundle's `messaging` permission and declared channel schema.
interface messaging {
    /// Sends a typed record only on a signed channel and schema authorized for this bundle.
    send: func(channel: string, schema: u16, record-json: list<u8>) -> result<_, string>;
    /// During init, sends the registry request and defers callbacks until a successful dispatch
    /// on confirmation-channel. The SDK validates its fingerprint and runs authored init there.
    /// The caller then dispatches latest state before ordered events. Queue overflow stops the part.
    @since(version = 1.4.0)
    negotiate: func(confirmation-channel: string, request-channel: string, schema: u16, fingerprint: string);
}

/// Retained presentation objects; no ECS, shaders or graphics API handles.
/// Grants: The signed client bundle's `scene` permission.
interface scene {
    /// Retains or replaces the object with this bundle-local ID; none removes it.
    put: func(id: u32, object-json: option<list<u8>>) -> result<_, string>;
}

/// Media IDs reference signed descriptors, never guest-selected URLs.
/// Grants: The signed client bundle's `media` permission and indexed descriptors.
interface media {
    /// Playback requests against a signed media descriptor.
    enum operation { prepare, play, pause, seek, stop }
    /// Requests playback state or a seek position in milliseconds for an authorized media ID.
    control: func(id: string, op: operation, position-ms: u64) -> result<_, string>;
}

/// Programmable world materials for the bundle's own entities and blocks, under the
/// `render_world_material` permission. A material is a WGSL `shade` function the host
/// validates and composes into its entity and terrain pipelines; the host owns depth, blend,
/// pass order and visibility, and applies Bedrock lighting and fog to the surface it returns.
/// Bindings name only identifiers in the manifest's signed `namespace`.
@since(version = 1.6.0)
interface world-material {
    /// `always` draws through other geometry and also needs `render_through_walls`.
    enum depth { test, always }
    /// The host blend class, which also selects the pass the material draws in.
    enum blend { opaque, cutout, premultiplied, additive }
    record material-spec {
        /// Defines `fn shade(input: WorldMaterialInput) -> Surface`; no resources, globals,
        /// loops or entry points.
        source: string,
        /// Signed bundle PNGs under `textures/`, at most four, read by `texture(index, uv)`.
        textures: list<string>,
        /// At most sixteen finite numbers, read by `param(input, index)`.
        params: list<f32>,
        depth: depth,
        blend: blend,
    }
    /// What a binding restyles: an entity type or a block, by namespaced identifier.
    variant target { entity(string), block(string) }
    /// Validates and declares material `id`, replacing any material of that id; its bindings
    /// follow the replacement. Each call counts against the per-callback compile budget.
    set-material: func(id: u32, spec: material-spec) -> result<_, string>;
    /// Removes material `id`; refused while a binding names it.
    remove-material: func(id: u32) -> result<_, string>;
    /// Draws `target` with material `material`, replacing binding `id`.
    bind: func(id: u32, target: target, material: u32) -> result<_, string>;
    /// Removes binding `id`; the target draws with its Bedrock material again.
    unbind: func(id: u32) -> result<_, string>;
}

/// World material effects beyond `shade`, each under a permission of its own besides
/// `render_world_material`: displacement under `render_world_material_vertex`, reading the
/// scene under `render_world_material_scene`, and outlines, bloom, particles and compute
/// cells under `render_world_material_passes`. Each draws only the targets the material is
/// bound to; nothing a material draws or computes is ever read back to the guest.
@since(version = 1.7.0)
interface world-material-effects {
    use world-material.{material-spec};
    /// An outline around what can be seen of each bound target, at most eight screen pixels
    /// wide, in the colour of the material's `fn outline(input: WorldMaterialInput) -> vec3<f32>`
    /// where the target meets the outline.
    record outline { width-pixels: f32 }
    /// A blur of what the bound targets emit, at most four times as strong and sixteen
    /// screen pixels wide, added over the frame.
    record bloom { strength: f32, radius-pixels: f32 }
    /// At most 4096 pixel squares around each bound target, placed within `radius-blocks`
    /// (at most four) by the material's `fn particle(input: WorldParticleInput) ->
    /// WorldParticle`.
    record particles { count: u32, radius-blocks: f32 }
    record effects {
        /// Moves the drawn geometry by the material's
        /// `fn displace(input: WorldVertexInput) -> vec3<f32>`, clamped on each axis to this
        /// many blocks (at most two). Culling grows by it; hit boxes and positions never move.
        displacement-blocks: option<f32>,
        /// Lets `shade` read the view's opaque colour and depth already drawn, with
        /// `scene_color` and `scene_depth`. Premultiplied and additive classes only.
        scene: bool,
        outline: option<outline>,
        bloom: option<bloom>,
        particles: option<particles>,
        /// The compute declaration whose cells the material's functions read with `cell`.
        cells: option<u32>,
    }
    /// Validates and declares material `id` with `effects`, as `world-material.set-material`
    /// does without them; each call counts against the per-callback compile budget.
    set-material-with-effects: func(id: u32, spec: material-spec, effects: effects) -> result<_, string>;
    /// A compute declaration: `cells` (at most 65536) cells of four numbers the host owns for
    /// the bundle, each set once per frame to what
    /// `fn step(input: WorldCellInput) -> vec4<f32>` returns from the previous frame's cells.
    /// A bundle's computes together update at most 262144 cells a frame.
    record compute-spec {
        source: string,
        cells: u32,
        /// At most sixteen finite numbers, read by `compute_param(index)`.
        params: list<f32>,
    }
    /// Validates and declares compute `id`, replacing any of that id; new parameters alone
    /// keep its cells. Each call counts against the per-callback compile budget.
    set-compute: func(id: u32, spec: compute-spec) -> result<_, string>;
    /// Removes compute `id`; refused while a material reads its cells.
    remove-compute: func(id: u32) -> result<_, string>;
}
