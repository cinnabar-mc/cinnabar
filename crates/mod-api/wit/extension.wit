package cinnabar:extension@0.1.0;

/// The mod's retained gameplay HUD layer and the vanilla HUD elements around it.
/// Every function except `set-label` requires hud authority.
/// Grants: `hud`, except set-label, which needs no grant.
interface hud {
    /// Replaces this mod's label. Empty text removes it; invalid text is rejected.
    set-label: func(text: string) -> result<_, string>;
    /// Adds one bounded local-only system chat line after a successful callback.
    local-message: func(text: string) -> result<_, string>;
    /// Replaces the mod's JSON-UI layer, drawn over gameplay below vanilla screens and never
    /// hit-tested. The JSON is a bounded surface: `screen`, `document`, `bindings`,
    /// `collections` and `transitions`, as panel surfaces. Empty text removes the layer.
    set-surface: func(json: string) -> result<_, string>;
    /// Sparse patch of the current layer; omitted names keep their values. `remove_bindings`
    /// lists bound names to unbind first, each once, none also set by the patch and at most
    /// the binding limit; a removed name the document still reads draws as never bound.
    /// `bindings` then replaces every binding, `binding_changes` sets the named ones and
    /// `collection_order` reorders collections. `controls` maps top-level control names of
    /// the document, without namespace and optionally with an `@` base as a document key, to
    /// a replacement control object, or to null to remove one. The patched document is
    /// validated as `set-surface` validates a whole one, and only the controls whose
    /// resolution reads a replaced definition, embedded ones included, are laid out again.
    update-surface: func(json: string) -> result<_, string>;
    /// The gameplay HUD root in GUI units and the GUI scale.
    record viewport { width: f32, height: f32, scale: f32 }
    /// None before the first laid-out frame.
    read-viewport: func() -> option<viewport>;
    /// Fonts a surface label can use.
    enum font { native, sans }
    /// Width of one line of text in GUI units at text scale 1, as a surface label lays it out.
    measure-text: func(text: string, font: font) -> result<f32, string>;
    /// Vanilla HUD elements a mod may read and hide.
    enum vanilla-element { crosshair, status-effects, sidebar, hunger }
    /// A rectangle in GUI units from the top left of the HUD root.
    record rect { x: f32, y: f32, width: f32, height: f32 }
    /// Whether vanilla draws the element this frame, ignoring hiding, and where. `bounds`
    /// covers what vanilla draws: the drawn row of shanks for `hunger`, not its renderer
    /// node; the effect icons for `status-effects`; the cursor for `crosshair`; the sidebar's
    /// rows for `sidebar`. None while vanilla lays the element out nowhere.
    record element-state { element: vanilla-element, visible: bool, bounds: option<rect> }
    /// Retained; the listed elements are not drawn. An empty list restores them all.
    set-hidden-elements: func(elements: list<vanilla-element>) -> result<_, string>;
    /// The current state of every vanilla element, in enum order.
    read-elements: func() -> result<list<element-state>, string>;
}

/// Native item and effect facts from the pinned tables and the installation's food definitions.
/// Requires player-state authority. A callback may make `MAX_FACT_READS` reads, counted apart
/// from player-state reads; one more traps it.
/// Grants: `player_state`.
interface facts {
    /// Food attributes from an installed item definition; saturation is a modifier, not current saturation.
    record food { nutrition: u32, saturation-modifier: f32 }
    /// Amplifier is zero-based; duration none is instant.
    record potion-effect { effect-id: s32, amplifier: s32, duration-ticks: option<u64> }
    /// Known item properties; absent properties must not be treated as zero.
    record item-facts {
        /// The pinned maximum; none for items that take no damage or whose maximum is unknown.
        max-durability: option<u32>,
        /// The installation's food definition for the identifier or its pinned legacy name.
        /// Server item components are not consulted; `vitals.held-food` reports those.
        food: option<food>,
        /// The effects of the potion that potions, splash and lingering potions carry by
        /// metadata, and tipped arrows by metadata minus one. Durations are the potion's own, a
        /// quarter of them for lingering potions; tipped arrows report the carried potion's.
        potion-effects: list<potion-effect>,
    }
    /// None when neither the pinned item facts nor the installed food know the identifier.
    read-item: func(identifier: string, metadata: u32) -> result<option<item-facts>, string>;
    /// One installed food definition; metadata none applies to every variant of the item.
    record food-item { identifier: string, metadata: option<u32>, food: food }
    /// Every item the installation's food table defines, by the identifiers `read-item`
    /// resolves: a pinned legacy name is listed as the items that alias it. The table defines
    /// food per identifier, so metadata is none. Sorted by identifier, at most
    /// `facts::MAX_FOOD_ITEMS`, keeping the first; identifiers over `MAX_ITEM_IDENTIFIER_BYTES`
    /// are left out. Empty while no food table is installed. One read.
    read-foods: func() -> result<list<food-item>, string>;
    /// A status effect's localization key and HUD icon texture as JSON-UI names it, without an
    /// extension; the texture is empty for effects without a HUD icon.
    record effect-facts { name-key: string, texture: string }
    /// None for an unknown effect id.
    read-effect: func(effect-id: s32) -> result<option<effect-facts>, string>;
}

/// Local wall-clock time; requires the clock grant.
/// Grants: `clock`.
interface clock {
    /// Milliseconds since the Unix epoch and the local zone's current offset from UTC.
    record local-time { unix-ms: u64, utc-offset-seconds: s32 }
    /// Reads the local machine clock and its current UTC offset with clock authority.
    read-local-time: func() -> result<local-time, string>;
}

/// Mod-supplied parameters of native world presentation; requires hud authority, and nonempty
/// per-actor lists also players or entities. Each call replaces this mod's retained value once
/// the callback succeeds; a callback may make 8 presentation calls, and one more traps it.
/// Limits are the constants in `mod_api::presentation`.
///
/// The client merges loaded mods in load order. The earliest mod that sets a nametag style, a
/// hurt overlay or chat actions owns that policy. For each runtime ID and surface, the earliest
/// mod whose grants admit the actor's kind owns the row: players need the players grant, other
/// actors the entities grant, and rows a mod's grants do not admit never apply. Tooltip lines
/// append in load order.
/// Grants: `hud`; actor rows additionally require `players` or `entities` for their kind.
interface presentation {
    use render.{rgba};
    /// Parameters of the native nametag renderer: opacity 0–1, scale 0.5–3, border width 0–8.
    /// Text colours replace the native ones when present; annotation spans keep their own.
    record nametag-style {
        hide: bool, hide-players: bool, hide-passengers: bool,
        show-self: bool, show-when-hud-hidden: bool,
        opacity: f32, scale: f32, shadow: bool, border-width: f32,
        text-color: option<rgba>, own-text-color: option<rgba>,
        border-color: option<rgba>, background-color: option<rgba>,
    }
    /// Retained; none restores native nametags.
    set-nametag-style: func(style: option<nametag-style>) -> result<_, string>;
    /// Plain single-line text of at most `MAX_ANNOTATION_SPAN_BYTES`, without style codes.
    record text-span { text: string, color: rgba }
    /// Where annotation spans go relative to the native name. Spans draw end to end in list
    /// order, with nothing inserted between them. `before` and `after` extend the name's first
    /// line, and the host inserts exactly one space between the name and the spans; any other
    /// separator belongs in the spans. `above` and `below` draw the spans on their own centred
    /// line above the name's first line or below its last. A player-list row has one line, so
    /// roster spans placed `above` or `below` follow the name as `after` does.
    enum annotation-position { before, after, above, below }
    /// Text attached to one actor's eligible nametag and, for a player whose actor the client
    /// knows, that player's player-list row. Each surface holds up to `MAX_ANNOTATION_SPANS`
    /// spans; an empty list leaves that surface native. Nametag spans on the local player also
    /// show its own tag. Runtime IDs are nonzero and distinct within one call.
    record annotation {
        runtime-id: u64,
        nametag: list<text-span>,
        nametag-position: annotation-position,
        roster: list<text-span>,
        roster-position: annotation-position,
    }
    /// Retained; replaces every annotation from this mod, at most `MAX_ANNOTATIONS`.
    set-annotations: func(annotations: list<annotation>) -> result<_, string>;
    /// Native damage overlay colours for actor bodies and their armour, while an actor is hurt;
    /// none keeps native. One policy: the earliest mod setting either colour owns both.
    set-hurt-overlay: func(body: option<rgba>, armor: option<rgba>) -> result<_, string>;
    /// An overlay tint drawn while the actor is not hurt.
    record actor-tint { runtime-id: u64, color: rgba }
    /// Retained; replaces every tint from this mod, at most `MAX_ACTOR_TINTS` distinct nonzero
    /// runtime IDs.
    set-actor-tints: func(tints: list<actor-tint>) -> result<_, string>;
    /// One extra item tooltip line of plain text, at most `MAX_TOOLTIP_LINE_BYTES`; metadata
    /// none matches every variant. One item's tooltip shows at most `MAX_ITEM_TOOLTIP_LINES`.
    record tooltip-line { identifier: string, metadata: option<u32>, text: string, color: rgba }
    /// Retained; replaces every tooltip line from this mod, at most `MAX_TOOLTIP_LINES`.
    set-tooltip-lines: func(lines: list<tooltip-line>) -> result<_, string>;
    /// A clickable span: a primary click or tap on `text` inside a message of the open chat
    /// history closes the chat and reports `action`, with value 1, among `input.read-controls`
    /// events on the owning mod's next frame; reading it requires controls authority. `text` is
    /// at most `MAX_CHAT_ACTION_TEXT_BYTES`; `action` is at most `MAX_CHAT_ACTION_ID_BYTES` of
    /// `[A-Za-z0-9_.-]`.
    record chat-action { text: string, action: string }
    /// Retained; replaces every chat action from this mod, at most `MAX_CHAT_ACTIONS`. The
    /// earliest mod with chat actions owns every clickable span and receives every click.
    set-chat-actions: func(actions: list<chat-action>) -> result<_, string>;
}

/// Read-only, session-bound facts about the local player's presented inventory and effects.
/// Grants: `player_state` for local observations; actor reads instead require `players` or `entities` for their kind.
interface player-state {
    /// One presented item stack, retaining wire identity when a name is unavailable.
    record item {
        /// None when the negotiated registry cannot resolve the item.
        identifier: option<string>,
        network-id: s32,
        metadata: u32,
        count: u16,
        /// Canonical block-item route or a retained wire block identity.
        block: bool,
        /// Accepted response corrections take precedence over the stack's Damage tag.
        damage: option<u32>,
        /// None for items without a known durability maximum, including custom components.
        max-durability: option<u32>,
    }
    /// Preserves whether a cell is known separately from whether it contains an item.
    record slot {
        /// False until this inventory cell has authoritative or selected-equipment evidence.
        known: bool,
        item: option<item>,
    }
    /// One currently presented status effect; amplifier and duration keep their wire units.
    record effect {
        effect-id: s32,
        /// The wire amplifier is zero-based and is not a display level.
        amplifier: s32,
        /// Remaining 20 Hz server ticks; none is an infinite effect.
        remaining-ticks: option<u64>,
        ambient: bool,
        particles: bool,
    }
    /// Inventory and effects from one session and dimension; unknown cells stay in place.
    record snapshot {
        session: u64,
        dimension: s32,
        selected-slot: option<u8>,
        /// Exactly 36 cells, with hotbar cells first, in the host's presented inventory order.
        inventory: list<slot>,
        /// Helmet, chestplate, leggings, boots, with unknown cells preserved.
        armor: list<slot>,
        offhand: slot,
        /// Currently visible status effects, sorted by effect id, without expired entries.
        effects: list<effect>,
    }
    /// Local feet and life state fenced to a connected destination and dimension.
    record world-observation {
        session: u64,
        /// Stable, host-selected destination identity; never a session generation.
        %world: string,
        dimension: s32,
        position: tuple<f32, f32, f32>,
        alive: bool,
        /// The local player's actor runtime ID, as actor observations and annotations use it.
        runtime-id: u64,
    }
    /// Presented local motion, readable without owning gameplay input.
    record motion {
        session: u64, dimension: s32,
        /// Actor YXZ degrees: yaw left and pitch up. Velocity is blocks per simulation tick.
        yaw: f32, pitch: f32, velocity: tuple<f32, f32, f32>, on-ground: bool,
    }
    /// Food values associated with the held item, including server item components.
    record food {nutrition: u32, saturation-modifier: f32}
    /// Authoritative food attributes; unavailable attributes remain absent.
    record vitals {
        session: u64, dimension: s32,
        /// Hunger, its maximum and saturation are attribute points: 20 is full vanilla hunger.
        hunger: option<f32>, max-hunger: option<f32>, saturation: option<f32>, held-food: option<food>,
    }
    /// An axis-aligned box in world coordinates, with minimum and maximum corners.
    record bounds { min: tuple<f32, f32, f32>, max: tuple<f32, f32, f32> }
    /// An admitted actor in the presented world; optional targeting facts are not estimates.
    record actor {
        session: u64, dimension: s32, runtime-id: u64, player: bool,
        position: tuple<f32, f32, f32>, boxes: list<bounds>, name: string,
        identifier: string, yaw: f32, pitch: f32, pickable: bool,
        /// Native attack ray eligibility with current world obstruction/reach; absent when no valid ray exists.
        hittable: option<bool>,
        /// Retained native look origin and direction, not a guessed bounding-box eye height.
        look-origin: option<tuple<f32,f32,f32>>, look-direction: option<tuple<f32,f32,f32>>,
        invisible: bool, sneaking: bool, hurt: bool, health: option<f32>,
    }
    /// An actor observation with its independently replicated health maximum.
    record observed-actor {
        actor: actor,
        /// Replicated health attribute maximum; absent when the server has supplied none.
        max-health: option<f32>,
    }
    /// `totem` is a totem-of-undying activation on `runtime-id`, local or remote, and `death` a
    /// server death notice. Read event lives with `read-combat-lives` and current actor lives
    /// with `read-actor-lives`.
    enum combat-kind { attack-admitted, hurt, death, totem }
    /// Retained combat evidence scoped to a session and dimension; it does not identify an attacker.
    record combat-event {
        sequence: u64, session: u64, dimension: s32, kind: combat-kind,
        local: bool, player: bool,
        runtime-id: u64, distance: option<f32>, position: tuple<f32, f32, f32>,
    }
    /// Read-only presented motion; requires player-state authority, including while menus own input.
    read-motion: func() -> result<option<motion>, string>;
    /// Authoritative current food attributes; unknown fields remain absent, never estimated.
    read-vitals: func() -> result<option<vitals>, string>;
    /// Actual upstream round-trip milliseconds; absent before measurement or when unsupported.
    read-ping: func() -> result<option<u32>, string>;
    /// At most 16 nearby actors within 128 blocks; player rows require players, other rows entities.
    read-actors: func() -> result<list<actor>, string>;
    /// Reads a smaller prefix of the same authorized observations to bound guest copying work.
    /// limit is 1 through MAX_OBSERVED_ACTORS; filtering and session authority are unchanged.
    read-actors-limited: func(limit: u32) -> result<list<observed-actor>, string>;
    /// An admitted actor's current life: `life` changes whenever the actor spawns again or dies,
    /// and `dead` is its current death state. Compare lives within one session.
    record actor-life { life: u64, dead: bool }
    /// One entry per requested runtime ID, in order, regardless of distance or the actor reads'
    /// limit: none when the session has no such admitted actor in the current dimension, or the
    /// caller lacks the grant for its kind. Player rows require players, other rows entities.
    /// At most MAX_ACTOR_LIFE_READS IDs; shares the actor reads' callback allowance.
    read-actor-lives: func(runtime-ids: list<u64>) -> result<list<option<actor-life>>, string>;
    /// Incremental retained evidence, at most 4 entries per read. Requires player-state authority.
    /// Attack admission is outbound intent, NOT server confirmation; hurt carries NO attacker attribution.
    read-combat: func(after: u64, limit: u32) -> result<list<combat-event>, string>;
    /// The actor's `read-actor-lives` life when each combat event was recorded, in request order.
    /// Death events carry the life after the death. Compare lives within one session.
    /// None when the event is no longer retained, belongs to another session or dimension, or
    /// the caller cannot read it. Requires the same grants as `read-combat` and shares its
    /// callback allowance. At most MAX_COMBAT_LIFE_READS sequences.
    read-combat-lives: func(sequences: list<u64>) -> result<list<option<u64>>, string>;
    /// One retained received chat message, addressed by a monotonic sequence.
    record chat-message { sequence: u64, text: string }
    /// Newest 32 retained received messages, filtered by sequence > after, in FIFO order.
    /// limit is 1 through 4; individual text fields are at most 256 UTF-8 bytes.
    read-chat: func(after: u64, limit: u32) -> result<list<chat-message>, string>;
    /// The server world clock: `time` is the absolute ticks the server last set, advanced at 20
    /// per second while its daylight cycle runs, 24000 per day. `daylight-cycle` is the server's
    /// daylight-cycle rule. Visual time overrides never apply.
    record world-time { session: u64, time: s64, daylight-cycle: bool }
    /// Requires player-state authority; none outside a connected session or before the server
    /// sets a time.
    read-world-time: func() -> result<option<world-time>, string>;
    /// A resolved sidebar label paired with its server-provided score.
    record sidebar-row { label: string, score: s32 }
    /// The currently resolved sidebar title and ordered rows.
    record sidebar { title: string, rows: list<sidebar-row> }
    /// Session-fenced feet position and life state, readable while menus own input.
    read-world: func() -> result<option<world-observation>, string>;
    /// Measured completed client frames per real second, never the configured limit.
    read-fps: func() -> result<option<f32>, string>;
    /// Ordered, resolved sidebar names; none when the server has no sidebar.
    read-sidebar: func() -> result<option<sidebar>, string>;
    /// Requires the player-state grant. None outside the current connected session.
    /// Available while a screen owns input; carries no camera, interaction or packet authority.
    read-snapshot: func() -> result<option<snapshot>, string>;
    /// Exact content token for the current snapshot, scoped to this component instance.
    /// None outside a current snapshot. Shares the read-snapshot grant and read budget.
    /// Contents equal to the last full read reuse its token, even after unimported changes.
    read-revision: func() -> result<option<u64>, string>;
    /// The equipment family of a snapshot, without copying status effects.
    record equipment {
        session: u64, dimension: s32, selected-slot: option<u8>,
        inventory: list<slot>, armor: list<slot>, offhand: slot,
    }
    /// The effect family of a snapshot, without copying equipment.
    record effects { session: u64, dimension: s32, effects: list<effect> }
    /// Independent exact-content tokens for equipment and effects within an instance.
    record revisions { session: u64, dimension: s32, equipment: u64, effects: u64 }
    /// Independent exact observation tokens. Equipment is unaffected by ticking effects.
    /// Tokens advance on observed changes and never repeat within an instance, including reconnects.
    /// These three reads share read-snapshot's grant, bounds, and callback read allowance.
    read-revisions: func() -> result<option<revisions>, string>;
    /// Reads only equipment under the snapshot grant and shared read allowance.
    read-equipment: func() -> result<option<equipment>, string>;
    /// Reads only effects under the snapshot grant and shared read allowance.
    read-effects: func() -> result<option<effects>, string>;
}

/// An opt-in retained settings panel, rendered and hit-tested by the host.
/// Grants: `controls`.
interface panel {
    /// One numeric control event routed to its owning mod by control ID.
    record event { id: string, value: f32 }
    /// Changes this instance's panel input ownership on successful callback return.
    /// Requires controls authority and a retained or pending panel when opening.
    set-open: func(open: bool) -> result<_, string>;
    /// Bounded panel JSON; empty text removes the panel and releases its input. A
    /// `cinnabar_hud_control` node draws a named control of this mod's HUD surface, centred:
    /// its laid-out box fitted to the node, or at `scale` times its HUD size, or with `fit`,
    /// its painted ink filling that fraction of the node, at most `max_scale` times its HUD
    /// size.
    set-content: func(json: string) -> result<_, string>;
    /// Applies a bounded sparse control patch and registered surface route atomically.
    /// Omitting controls preserves them; bindings, when present, replace custom scalars.
    /// The JSON record optionally accepts collection_reveal: {collection: string, item: u32}.
    /// The item is its immutable published index, resolved through the accepted collection_order.
    /// Each request is consumed once; a filtered-out item is ignored.
    /// Optional show_gameplay_hud: bool changes whether the gameplay HUD and mods' HUD
    /// surfaces stay drawn under the open panel; it lasts until changed again or until
    /// set-content replaces the panel.
    update-content: func(json: string) -> result<_, string>;
    /// Where this mod's panel lies over the HUD root as last laid out: the panel root's
    /// `width` and `height` in panel units, `scale`, the HUD GUI units one panel unit spans,
    /// which follows the GUI scale and a `reference_size` fitted to a small window, and
    /// `offset`, the panel root's top left in HUD GUI units from the HUD root's top left. The
    /// pointer of `input.read-controls` at `p` lies at `(p - offset) / scale` in panel units.
    record panel-layout { width: f32, height: f32, scale: f32, offset: tuple<f32, f32> }
    /// Requires controls authority; none without it and while this mod's panel is not open.
    read-layout: func() -> option<panel-layout>;
}

/// Introspection of the running callback's own execution allowance. It reads no game state
/// and grants no game capability, so it needs no grant.
/// Grants: None; only the current callback allowance is exposed.
interface budget {
    /// Fuel left in the running callback, about the WebAssembly instructions it may still
    /// execute before it traps. Mods use it to spread large work over later callbacks.
    remaining-fuel: func() -> u64;
}

/// Settings belong to the selected component's fixed companion file.
/// Grants: `settings`.
interface settings {
    /// Returns this component's bounded companion JSON; no guest-selected path is accepted.
    load: func() -> result<string, string>;
    /// Stages bounded JSON for persistence after a successful callback.
    save: func(json: string) -> result<_, string>;
}

/// Local control edges, available only with explicit controls authority.
/// Grants: `controls`, except demo-pressed, which needs no grant.
interface input {
    use panel.{event};
    /// A committed native field value addressed by its declared control ID.
    record text-event { id: string, value: string }
    /// A field navigation key with modifiers sampled at the key edge.
    record field-key {
        id: string, key: string,
        shift: bool, control: bool, alt: bool, super-key: bool,
    }
    /// A native edit, submission or navigation edge; composition remains host-owned.
    variant field-event {
        change(text-event),
        submit(text-event),
        key(field-key),
    }
    /// One focused input sample; keys and pointer use the host's coordinate and naming contracts.
    record controls {
        seconds: f32,
        focused: bool,
        gameplay: bool,
        panel-open: bool,
        /// Physical non-repeat edges; pointer buttons use MouseLeft/MouseRight/MouseMiddle.
        keys-pressed: list<string>,
        /// Physical keys held this frame, including reserved ones, in physical-name order.
        /// Truncated to MAX_CONTROL_KEYS when more are held.
        keys-held: list<string>,
        /// Held desktop keys/buttons admitted by the finalized gameplay router, including
        /// modifiers. Uses keys-held names and bounds; excludes consumed, quarantined,
        /// reserved and ineligible-device controls. Empty outside gameplay input ownership.
        /// Match read-bindings chords against this list, respecting modifier precedence.
        /// This is physical admission, never a resolved action or permission to act.
        /// Same physical-name order as keys-held, independently truncated to MAX_CONTROL_KEYS.
        /// Above that held-key cap, chord resolution can differ from the host's gate.
        keys-admitted: list<string>,
        events: list<event>,
        /// Pointer position in the gameplay HUD root's GUI units from its top left, the space of
        /// `hud.read-viewport`, while this mod's open panel owns input; none otherwise. A panel's
        /// own fitting, such as a `reference_size` scaled to a small window, does not change it.
        pointer: option<tuple<f32, f32>>,
        /// Wheel notches this frame while this mod's panel owns input; positive scrolls up.
        wheel: f32,
    }
    /// Selects which fields to copy without changing the underlying frame or its event ordering.
    record selection {
        /// None selects all keys; some(empty) selects none; names select exact matches.
        keys-pressed: option<list<string>>,
        keys-held: option<list<string>>,
        keys-admitted: option<list<string>>,
        events: bool,
    }
    /// The context in which the player assigned a physical chord.
    enum binding-context { gameplay, ui }
    /// Modifier groups required in addition to the key; either side satisfies a group.
    record binding-modifiers { shift: bool, control: bool, alt: bool, super-key: bool }
    /// One player-assigned keyboard or observable mouse-button chord. Multiple rows are
    /// alternative bindings. More specific satisfied chords on the same key and context
    /// take precedence. Keys use exactly the controls.keys-held naming contract.
    record action-binding {
        /// Stable input Action names in kebab-case: move-forward, move-backward, move-left,
        /// move-right, look-up, look-down, look-left, look-right, jump, sneak, sprint, attack,
        /// use, cycle-perspective, menu, back, hotbar-1 through hotbar-9, hotbar-previous,
        /// hotbar-next, ui-up, ui-down, ui-left, ui-right, ui-accept, ui-cancel, ui-tab-next,
        /// ui-tab-previous, player-list, freelook, interact-with-toast, pick-item.
        action: string,
        context: binding-context,
        key: string,
        modifiers: binding-modifiers,
    }
    /// A page of the player's current chords, in settings order. Total is at most
    /// MAX_INPUT_BINDINGS; entries has at most MAX_INPUT_BINDINGS_PER_READ rows.
    /// Only keyboard keys and MouseLeft/MouseRight/MouseMiddle are observable here; mouse
    /// axes, additional buttons, gamepads and built-in touch controls are not in keys-held.
    record bindings { revision: u64, total: u32, entries: list<action-binding> }
    /// Requires controls authority and shares read-controls' callback read allowance.
    /// Offset is 0 through total, and limit is 1 through MAX_INPUT_BINDINGS_PER_READ.
    /// Pass the last complete revision to receive none while unchanged. To collect pages,
    /// pass none, advance offset by each page's length and restart at zero if revision changes.
    /// Discard old assignments while collecting a changed revision; apply complete revisions.
    /// Revisions are host-local: clear guest caches on reinitialization. Returns an error
    /// until settings are sampled or for invalid page bounds. Does not resolve actions.
    read-bindings: func(after: option<u64>, offset: u32, limit: u32) -> result<option<bindings>, string>;
    /// True only for the current frame's host-assigned action edge.
    demo-pressed: func() -> bool;
    /// Reads this callback's control sample with controls authority and the shared read allowance.
    read-controls: func() -> result<controls, string>;
    /// Reads selected fields from the same current frame, preserving native key order.
    /// Requires controls authority and shares the read-controls callback read budget.
    read-selected-controls: func(selection: selection) -> result<controls, string>;
    /// Committed single-line native text edits, separate from legacy numeric control events.
    /// Requires controls authority; repeated reads see the same bounded batch in a frame callback.
    read-text-events: func() -> result<list<text-event>, string>;
    /// Live values coalesce per field between frame callbacks. Submit and navigation retain order.
    /// Navigation includes the modifiers sampled at that key edge; preedit stays host-local.
    read-field-events: func() -> result<list<field-event>, string>;
    /// Physical key names reserved before the ordinary gameplay router samples them.
    reserve-keys: func(keys: list<string>) -> result<_, string>;
}

/// Local presentation only; no world mutation or outbound packets.
/// Grants: `environment` for weather and time; `fullbright` for lighting.
interface environment {
    /// Local visual weather target; none restores tracked server weather.
    enum weather { clear, rain, thunder }
    /// Retains a local weather target after success; none resumes tracked server weather.
    set-weather-override: func(value: option<weather>) -> result<_, string>;
    /// Fixes visual time to 0–23999 ticks; none restores the tracked server clock.
    set-time-override: func(ticks: option<u32>) -> result<_, string>;
    /// Retained local lighting override; requires the separate fullbright grant.
    set-fullbright: func(enabled: bool) -> result<_, string>;
}

/// Explicit local gameplay capabilities; no raw packet access.
/// Grants: Per operation: `players`, `terrain`, `movement`, `camera`, `interaction`, `entities`, `commands` or `packet_delay`; see each function.
interface gameplay {
    /// Three coordinates; the containing record or function specifies their units and frame.
    record vector3 { x: f32, y: f32, z: f32 }
    /// Remote player feet in world coordinates, without names or network access.
    record player { runtime-id: u64, position: vector3 }
    /// Current input-owned frame only. Angles are actor YXZ radians: yaw left, pitch up.
    record snapshot {
        session: u64,
        dimension: s32,
        eye: vector3,
        yaw: f32,
        pitch: f32,
        frame-seconds: f32,
        players: list<player>,
    }
    /// Requires players or terrain; player rows require players. None means gameplay does not own input.
    read-frame: func() -> result<option<snapshot>, string>;
    /// Input-owned local physics state; velocity is blocks per simulation tick.
    record movement-snapshot {
        session: u64,
        dimension: s32,
        tick: u64,
        velocity: vector3,
        on-ground: bool,
        eligible: bool,
        knockback-sequence: u64,
    }
    /// Requires movement authority; none means gameplay does not own input.
    read-movement: func() -> result<option<movement-snapshot>, string>;
    /// Stages one ordinary jump input for the next physics tick, with movement authority.
    pulse-jump: func() -> result<_, string>;
    /// Cancels pending local jump input after a successful callback, even outside gameplay.
    cancel-jump: func() -> result<_, string>;
    /// True holds the control as if its binding were held; false adds nothing to physical input.
    record movement-intents { sprint: bool, sneak: bool }
    /// Renew every focused gameplay frame; omission releases both intents. Requires movement
    /// authority; server movement, hunger and item-use restrictions still apply.
    set-movement-intents: func(intents: option<movement-intents>) -> result<_, string>;
    /// The game's own control modes, replacing the player's toggle sprint, toggle sneak and
    /// always sprint settings while renewed. Always sprint applies only to keyboard and mouse.
    record control-modes { toggle-sprint: bool, toggle-sneak: bool, always-sprint: bool }
    /// Renew every focused gameplay frame; omission restores the player's own settings.
    /// Requires movement authority. With several mods, a mode is on when any of them sets it.
    set-control-modes: func(modes: option<control-modes>) -> result<_, string>;
    /// Requires the camera grant and a current frame; commits only after frame returns.
    rotate: func(yaw-delta: f32, pitch-delta: f32) -> result<_, string>;
    /// Requires interaction authority; a non-none range also requires a current gameplay frame.
    /// Overrides local actor pick and attack range up to MAX_ENTITY_REACH_BLOCKS; none restores
    /// ordinary mode and input limits. Attack eligibility, obstruction and server validation
    /// still apply. Does not change mining or block-use reach.
    set-attack-reach: func(blocks: option<f32>) -> result<_, string>;
    /// One attack-press edge, only while the physical attack control is held.
    /// An active action filter receives it as a repeat.
    pulse-attack: func() -> result<_, string>;
    /// Requires packet-delay authority; 0 drains the queue, maximum 1000 milliseconds.
    /// Delays post-login application packets in both directions, without raw packet access.
    /// Retained only after a successful callback; no current gameplay frame required.
    set-packet-delay: func(delay-ms: u32) -> result<_, string>;
    /// Requires packet-delay authority: the local feet position last relayed to the server, which
    /// trails the presented position while packets are delayed. None outside gameplay or while no
    /// delay is active.
    read-relayed-position: func() -> result<option<vector3>, string>;
    /// The last rendered camera, including third-person and rig offsets. Angles are actor YXZ
    /// radians.
    record camera-pose { position: vector3, yaw: f32, pitch: f32 }
    /// Requires players or terrain, as read-frame. None means gameplay does not own input.
    read-camera: func() -> result<option<camera-pose>, string>;

    /// A nearby non-player actor; health comes from its replicated health attribute.
    record mob {
        runtime-id: u64,
        unique-id: s64,
        type-id: string,
        position: vector3,
        health: option<f32>,
        max-health: option<f32>,
    }
    /// Requires the entities grant and a current frame; nearest first, bounded by count and range.
    read-mobs: func() -> result<list<mob>, string>;

    /// Camera-local blocks (x right, y up, z back), roll in radians, FOV change in degrees.
    record camera-rig { offset: vector3, roll: f32, fov-delta: f32 }
    /// Retained third-person rig, swept against blocks; none restores the player's own view.
    set-camera-rig: func(rig: option<camera-rig>) -> result<_, string>;

    /// Sent as a player command request after frame returns; the command must be granted by name.
    request-command: func(command: string) -> result<_, string>;
}

/// Local presentation cues shared by loaded mods; they carry no authority.
/// Grants: None; cues carry no game authority.
interface events {
    /// A presentation-only signal with bounded scalar values, shared on the following frame.
    record cue { name: string, values: list<f32> }
    /// Published to the host and every loaded mod after frame returns.
    emit: func(name: string, values: list<f32>) -> result<_, string>;
    /// Cues loaded mods committed last frame; the same bounded list for every call in a callback.
    poll: func() -> list<cue>;
}

/// Local custom rendering: sandboxed WGSL post-process passes and bounded world-space primitives.
/// Grants: `render` or `world_draw` for primitives; `render` or `render_post` for post passes; `render_depth` additionally for scene depth.
interface render {
    use gameplay.{vector3};
    /// Linear colour; alpha scales coverage.
    record rgba { r: f32, g: f32, b: f32, a: f32 }
    /// Procedural ground styles animated by `progress` in 0–1.
    enum decal-style { telegraph, disc, crater, shockwave, dust }
    /// A procedural ground primitive whose progress selects its current animated appearance.
    record decal { center: vector3, radius: f32, color: rgba, progress: f32, style: decal-style }
    /// Camera-facing strip that tapers and fades from the first point (head) to the last.
    record ribbon { points: list<vector3>, width: f32, color: rgba }
    /// Glowing animated strip from start to end; intensity scales its white-hot core.
    record beam { start: vector3, end: vector3, width: f32, color: rgba, intensity: f32 }
    /// The host's procedural coverage patterns for a billboard quad.
    enum billboard-pattern { solid, soft-disc, ring, spark, silhouette, sphere, aura }
    /// Camera-facing quad; upright quads keep their vertical axis.
    record billboard {
        position: vector3,
        width: f32,
        height: f32,
        color: rgba,
        pattern: billboard-pattern,
        upright: bool,
    }
    /// The world primitives appended by one call; successful callbacks replace prior frame output.
    record primitives {
        decals: list<decal>,
        ribbons: list<ribbon>,
        beams: list<beam>,
        billboards: list<billboard>,
    }
    /// `source` defines `fn effect(uv: vec2<f32>) -> vec3<f32>`, the new scene colour, against the host prelude.
    record pass-spec { name: string, order: s32, source: string, depth: bool }
    /// Validates a pass; passes run after the scene and before the HUD, by order then name.
    register-pass: func(spec: pass-spec) -> result<_, string>;
    /// Removes this mod's named post pass after the callback succeeds.
    remove-pass: func(name: string) -> result<_, string>;
    /// Retained enable flag and up to 16 floats exposed to the shader as `param(i)`.
    update-pass: func(name: string, enabled: bool, params: list<f32>) -> result<_, string>;
    /// Appends to this callback's primitives; each successful callback replaces the drawn set.
    draw: func(primitives: primitives) -> result<_, string>;
    /// Procedural line coverage; width and phase remain host-rendered.
    enum line-pattern { solid, dashed, dotted }
    /// Camera-facing line with width in physical pixels and an original procedural pattern.
    record line { points: list<vector3>, width: f32, color: rgba, pattern: line-pattern }
    /// Appends depth-tested lines with the same authority and shared ribbon budget.
    draw-lines: func(lines: list<line>) -> result<_, string>;
}

/// The mod's JSON-UI templates beside the vanilla container screens. Templates are the
/// `ui/<name>.json` files `mod.toml` indexes, in the mod's own namespace; they resolve only
/// against the vanilla catalog, as a client part's modal templates do. Every
/// mutation errs when the `screen` permission is denied.
/// Grants: `screen` for mutations; layout, held-modifiers and elapsed-seconds need no grant.
interface screen {
    use cinnabar:server-experience/ui@1.5.0.{value, gui-size};

    /// A rectangle in GUI units, from the top left of the screen root.
    record rect {
        x: f64,
        y: f64,
        width: f64,
        height: f64,
    }

    /// The open container screen as laid out for this frame.
    record screen-layout {
        /// The vanilla JSON-UI screen drawn, such as `crafting.inventory_screen`.
        screen: string,
        /// The root's size in GUI units and the GUI scale, as `ui.modal-size` reports them.
        size: gui-size,
        /// The union of the vanilla screen's laid-out panels, an open recipe book included.
        gui: rect,
        /// Other vanilla areas outside `gui` that the overlay may not draw on: the recipe book's
        /// tabs, the status effects and toasts.
        exclusions: list<rect>,
        /// The open view's laid-out bounds. While the view is up the vanilla screen is hidden,
        /// and the overlay is clipped against this rect (and the exclusions) instead of `gui`.
        view: option<rect>,
    }

    /// The modifier keys held with a wheel turn.
    flags modifiers {
        ctrl,
        shift,
        alt,
    }

    /// The open container screen's layout; none while no container screen is up.
    layout: func() -> option<screen-layout>;
    /// Draws `template` beside every container screen, laid out over the whole root but drawn
    /// and hit only outside `gui` and the exclusions; none removes it.
    set-overlay: func(template: option<string>) -> result<_, string>;
    /// Draws `template` over the open container screen, which stays open and is hidden while
    /// the view is up; none, Escape or closing the container returns. Errs while no container
    /// screen is up.
    open-view: func(template: option<string>) -> result<_, string>;
    /// Replaces a collection's rows, as client WIT 1.2's `ui.set-collection`.
    set-collection: func(name: string, rows-json: list<u8>) -> result<_, string>;
    /// Binds one `#binding` name for the overlay and the view, as `ui.set-value`.
    set-value: func(name: string, value: value) -> result<_, string>;
    /// Sets the text of edit boxes named `control`, as `ui.set-text`.
    set-text: func(control: string, text: string) -> result<_, string>;
    /// Selects the drawn edit box named `control`, as a press on it would.
    focus-text: func(control: string) -> result<_, string>;
    /// The modifier keys held with the event being delivered, such as Shift with a press.
    held-modifiers: func() -> modifiers;
    /// Monotonic seconds since the mod loaded, to animate by, as JEI cycles ingredients.
    elapsed-seconds: func() -> f64;
}

/// Vanilla inventory requests a player mod asks for; each is one the vanilla screens can make,
/// and the server checks it. Every function errs without the `inventory` permission. Requests
/// are sent after the callback returns, at most `MAX_INVENTORY_REQUESTS` per callback.
/// Grants: `inventory`.
interface inventory {
    use cinnabar:session/items@0.1.0.{item-key};

    /// Takes `count` of creative item `key` into the first free inventory slot, else the
    /// cursor, as a click on the creative catalog does. Errs outside Creative or when the
    /// item is not in the creative content.
    creative-take: func(key: item-key, count: u8) -> result<_, string>;
    /// Crafts crafting recipe `network-id` once from inventory ingredients onto the cursor, as
    /// a click on the recipe book does. Errs while no crafting screen is up.
    fill-recipe: func(network-id: u32) -> result<_, string>;
}

/// Opt-in local camera policy; requires the explicit camera grant.
/// Grants: `camera`.
interface camera {
    /// Degrees, each at most `MAX_VIEW_TILT_DEGREES`, added to the first-person view where the
    /// native damage shake applies; suppress-hurt-shake removes that shake. Positive pitch turns
    /// the view up. Positive roll turns it the way a native shake without direction does: the
    /// view's right edge rises, so the world appears to turn clockwise. A native shake of angle
    /// `a` from hurt direction `d` is approximately roll `a cos d` and pitch `-a sin d`.
    /// Death rotation, view bob, look and movement are unchanged.
    record view-tilt { roll: f32, pitch: f32, suppress-hurt-shake: bool }
    /// Current frame only, including while a menu owns input. None, omission, unload and failed
    /// callbacks restore the native view.
    set-view-tilt: func(tilt: option<view-tilt>) -> result<_, string>;
    /// Renew every frame. Only actual teleports preserve yaw/pitch; position and acknowledgments remain unchanged.
    /// Omission, no gameplay frame, or a failed callback restores server rotation.
    set-preserve-teleport-rotation: func(enabled: bool) -> result<_, string>;
    /// Current-frame FOV and look multipliers, independently bounded to 0.1..1 and 0.05..1.
    /// Renew only during focused, input-owned gameplay; 1/1 restores the player's view.
    /// Omission, UI focus, unload, and failed callbacks restore both scales without changing saved settings or perspective.
    set-view-scale: func(fov-scale: f32, look-scale: f32) -> result<_, string>;
    /// The native damage shake of the local player's last presented view, at full strength:
    /// before the player's damage-shake setting, any mod `view-tilt`, or suppression. Degrees,
    /// using the `view-tilt` sign convention: a tilt of these angles that suppresses the native
    /// shake presents the same view. None while no shake is active, in third person, or outside
    /// gameplay. Like a tilt, it continues while a menu owns input.
    record damage-shake { roll: f32, pitch: f32 }
    /// Requires the camera grant.
    read-damage-shake: func() -> result<option<damage-shake>, string>;
}

/// Opt-in item-use policy; requires the explicit item-use grant.
/// Grants: `item_use`.
interface item-use {
    /// One item-use press edge for the next gameplay tick, only while the physical use control
    /// is held. It skips only the client's use repeat delays: the rearm after an air use and the
    /// hold-off after an attack. Block interaction, item cooldowns and tick admission, at most
    /// one air use per tick from a hotbar slot, still apply. Requires a gameplay frame. An active
    /// action filter receives it as a repeat.
    pulse-use: func() -> result<_, string>;
}

/// Bounded local terrain reads. The queries a callback reads become its subscriptions, which the
/// client samples before later frames, so a new query reads `pending` first. A deferred callback
/// keeps its subscriptions. Unknown terrain is never reported as air.
/// Grants: `terrain`.
interface terrain {
    /// An integer block position in the current dimension.
    record position { x: s32, y: s32, z: s32 }
    /// Selects which block shapes to request; an empty set requests neither family.
    flags geometry { collision, selection }
    /// Inclusive minimum and exclusive maximum; each extent is 1 to `MAX_TERRAIN_EXTENT` blocks.
    record region-query { min: position, max: position, geometry: geometry }
    /// Identifies one sample of one query; an equal stamp means identical contents.
    record stamp { session: u64, dimension: s32, registry: u64, revision: u64 }
    /// Available block contact properties; missing physics remains absent on the block state.
    flags physics-flags { climbable, water, lava, cobweb, powder-snow, scaffolding, passable }
    /// The resolved contact response associated with the block's physics.
    enum surface-response { none, slime, bed, honey, soul-sand, bubble-up, bubble-down }
    /// Resolved movement and fluid properties, when the registry supplies them.
    record physics {
        friction: f64, horizontal-speed-factor: f64, vertical-speed-factor: f64,
        fluid-height: f64, %flags: physics-flags, surface: surface-response,
    }
    /// An index into the region's shapes; shape 0 is known-empty.
    variant resolved-shape { unavailable, known(u32) }
    /// Distinguishes unrequested, shared and position-dependent geometry without guessing boxes.
    variant shape-binding {
        not-requested,
        fixed(resolved-shape),
        /// Every occurrence has an override.
        per-cell,
    }
    /// One distinct runtime ID; metadata and physics are absent when the registry lacks them.
    record block-state {
        runtime-id: u32, identifier: option<string>, canonical-state: option<string>,
        tags: list<string>, physics: option<physics>,
        collision: shape-binding, selection: shape-binding,
    }
    /// Revision of a column the region depends on; none is absent terrain.
    record chunk-revision { x: s32, z: s32, revision: option<u64> }
    /// Geometry of one layer slot that depends on its position; none keeps the state's binding.
    record shape-override { slot: u32, collision: option<resolved-shape>, selection: option<resolved-shape> }
    /// Cell `((x * size-z) + z) * size-y + y`, relative to the minimum, has layer `l` at slot
    /// `l * cells + cell`. Shapes are block-local, with native position offsets applied.
    record region {
        stamp: stamp,
        /// Every column read, including those consulted for neighbour or actor geometry.
        chunks: list<chunk-revision>,
        layer-count: u8,
        /// Bit `cell % 64` of word `cell / 64` is set for known cells.
        loaded: list<u64>,
        /// Palette index per slot; 65535 is no layer, never air.
        states: list<u16>,
        palette: list<block-state>,
        /// Shape `s` is boxes `shape-offsets[s]` to `shape-offsets[s + 1]`.
        shape-offsets: list<u32>,
        /// Six values per box: minimum then maximum x, y and z.
        shape-boxes: list<f64>,
        /// Sorted by slot.
        overrides: list<shape-override>,
    }
    /// A deferred sample, an unchanged stamp or a complete changed region.
    variant read-result { pending, unchanged(stamp), changed(region) }
    /// Admission or availability failures; shrink a query when its response exceeds a limit.
    enum read-error { denied, unavailable, invalid-query, out-of-range, budget-exhausted, limit-exceeded }
    /// Requires terrain authority and a gameplay frame; the query lies within
    /// `MAX_TERRAIN_DISTANCE` blocks of the player's feet on each axis. Pass the stamp last received
    /// for this query to skip unchanged data. Limits are `mod-api`'s `MAX_TERRAIN_*` constants.
    read-region: func(query: region-query, after: option<stamp>) -> result<read-result, read-error>;
    /// Positions of loaded blocks whose identifier matches one of 1 to
    /// `MAX_FOUND_BLOCK_IDENTIFIERS` namespaced names, nearest first, within `range` blocks of
    /// the player's feet (1 to `MAX_TERRAIN_DISTANCE`) and at most `limit` results (1 to
    /// `MAX_FOUND_BLOCKS`). Like a region query, a search becomes a subscription that the client
    /// scans incrementally between frames, so a new search returns none and results fill in as
    /// loaded terrain is scanned. Searches and region queries share `MAX_TERRAIN_QUERIES` and
    /// the callback's terrain call budget. Requires terrain authority and a gameplay frame.
    find-blocks: func(identifiers: list<string>, range: f32, limit: u32) -> result<list<position>, read-error>;
}

/// Mod-owned on-screen buttons drawn in the built-in touch control style while touch controls
/// are shown. Players move them in the touch layout editor. Requires controls authority.
/// Grants: `controls`.
interface touch {
    /// A GUI-pixel pair.
    record point { x: f32, y: f32 }
    /// The screen edge or centre a placement measures from.
    enum anchor { top-left, top-center, top-right, left, center, right, bottom-left, bottom-center, bottom-right }
    /// A retained mod-owned touch control with player-adjustable default placement.
    record button {
        /// 1–32 bytes of lowercase ASCII letters, digits, `_` and `-`. A player's saved
        /// placement is keyed by it, so prefix it with the mod's name; when two mods use one
        /// id, only the earlier mod's button is shown.
        id: string,
        /// One line of 1–24 bytes of plain text without `§` codes, drawn centred as written.
        label: string,
        /// Default placement, in GUI pixels inward from the anchored edges or right/down from
        /// centred axes, each at most 1024.
        anchor: anchor,
        offset: point,
        /// Width and height in GUI pixels, each 18 through 96.
        size: point,
    }
    /// Replaces this instance's retained buttons, at most 4; an empty list removes them.
    /// Committed after a successful callback; quarantine, unload and revocation remove them.
    set-buttons: func(buttons: list<button>) -> result<_, string>;
    /// IDs of this instance's buttons tapped since its previous frame callback, oldest first.
    /// A tap completes when the finger lifts inside the button. Empty outside `frame`; a
    /// deferred frame keeps the taps for the next one.
    read-presses: func() -> result<list<string>, string>;
}

/// Experimental developer contract; no WASI or ambient operating-system access.
world extension {
    import cinnabar:world-draw/masks@0.2.0;
    import cinnabar:world-draw/assets@0.2.0;
    import terrain;
    import player-state;
    import item-use;
    import camera;
    import hud;
    import clock;
    import facts;
    import presentation;
    import input;
    import touch;
    import environment;
    import gameplay;
    import events;
    import panel;
    import settings;
    import render;
    import budget;
    import cinnabar:world-draw/drawing@0.2.0;
    /// Creates the initial retained UI state.
    export init: func();
    /// Bounded frame callback used to measure the spike's crossing cost.
    export frame: func();
}

/// Policy-free decisions on resolved, source-backed button actions.
/// Grants: `controls` to run the optional filter-actions export; this interface defines its shared types.
interface action-filter {
    /// Closed in this version; additional actions require a new optional export.
    enum filtered-action { attack, item-use }
    /// Repeat is an authorized pulse on physically held attack, not another device press.
    enum transition-kind { press, release, repeat }
    /// One resolved edge, with the physical held state immediately after it.
    record transition {
        action: filtered-action,
        kind: transition-kind,
        /// Resolved physical hold after this edge; another binding may still hold the action.
        held-after: bool,
    }
    /// Independent Attack and Use holds, interpreted as physical or logical by the parent field.
    record held { attack: bool, item-use: bool }
    /// One ordered action batch with continuity and real-time evidence for guest policy.
    record action-frame {
        /// Changes on owner replacement, callback failure or input-authority interruption.
        /// Clear guest policy state on a change. Suppressed gestures stay suppressed until
        /// physical release; retained releases are completed before this batch.
        epoch: u64,
        /// Absolute monotonic real time, in microseconds; idle callbacks may be skipped.
        time-us: u64,
        /// Held states immediately before transitions, after reset reconciliation.
        physical: held,
        logical: held,
        transitions: list<transition>,
    }
    /// One decision per transition plus explicit completion of retained releases.
    record action-verdict {
        /// Exactly one decision per transition, in order. False suppresses the edge.
        accepted: list<bool>,
        /// Completes retained releases before the batch. Ignored for physical holds.
        release: held,
    }
}

/// `extension` plus screens beside the container screens, the session's read-only items and
/// recipes, declared keys and event callbacks. A mod package (`mod.toml`) targets this world.
///
/// Every event export is optional: the host type-checks each one a component exports, refusing
/// one of another signature, and never calls one it lacks. New events arrive as new exports, so
/// a built component keeps working. `init` and `frame` stay required.
world player-mod {
    include extension;
    import screen;
    import inventory;
    import cinnabar:session/items@0.1.0;
    import cinnabar:session/recipes@0.1.0;

    use screen.{screen-layout, modifiers};
    use cinnabar:session/items@0.1.0.{stack};

    /// What a `data-changed` reports as changed. Closed: changing it would refuse every built
    /// `data-changed`, so a new kind of change arrives as a new optional export instead.
    enum data-source {
        items,
        recipes,
    }

    /// A container screen opened, closed (`none`) or was laid out anew.
    export screen-changed: func(layout: option<screen-layout>);
    /// A primary press on an overlay or view control mapped to a declared action; the index is
    /// the control's row in its nearest collection.
    export action: func(id: string, collection-index: option<u32>);
    /// A secondary press (a right click) on a control that maps `button.menu_secondary_select`
    /// to a declared action.
    export secondary-action: func(id: string, collection-index: option<u32>);
    /// The wheel turned `delta` notches (one per detent; a pixel-precise wheel reports its
    /// pixels / 16) with the pointer at `x`, `y` in GUI units, over the overlay's drawn area or
    /// the view, with `modifiers` held. Positive scrolls down, towards the end.
    export scrolled: func(delta: f64, x: f64, y: f64, modifiers: modifiers);
    /// The text of the edit box named `control`, a declared action, changed.
    export text-changed: func(control: string, text: string);
    /// A declared key was pressed while a container screen or the view was up and no edit box
    /// had focus. `hovered` is the vanilla slot's stack under the pointer; `row` is the
    /// collection name and index of the mod's control under the pointer, overlay or view, by
    /// the rule `action` uses (its nearest collection).
    export key: func(id: string, hovered: option<stack>, row: option<tuple<string, u32>>);
    /// The listed session sources changed revision, each listed once. It gets the load fuel
    /// budget, as does `init` of a component that exports it.
    export data-changed: func(sources: list<data-source>);
    /// The host closed the view (Escape, or the container closing), not the mod.
    export view-closed: func();
}

/// Explicit opt-in player-mod world for generic action filtering.
/// Existing player-mod components remain supported and do not claim filter ownership.
world filtered-player-mod {
    include player-mod;

    use action-filter.{action-frame, action-verdict};
    /// Optional and explicitly exported by filtering modules; requires controls authority.
    /// The earliest active exporting module is the sole owner. Runs after ordinary frame
    /// callbacks, before gameplay, with independent fuel and no host-import calls. Called for transitions and every
    /// frame with a retained hold. No callback is needed for an idle physical hold.
    /// Suppressing a release retains its hold. Suppressing its following press joins that
    /// hold; accepting that press completes the outstanding release before a fresh press.
    /// Suppressing a fresh press blocks its gesture until release. Rejected repeats leave
    /// the existing hold intact. Native never creates a press without an observed source.
    /// Traps or invalid verdicts quarantine the module and complete retained releases;
    /// owner loss and input-authority interruptions do the same. Suppressed physical holds
    /// stay suppressed until release. No duration or filtering policy is imposed by the host.
    export filter-actions: func(frame: action-frame) -> action-verdict;

}

/// Every session packet, relayed through one trusted mod. A batch is the session contract's batch
/// body: each packet as a varuint32 byte length followed by the encoded packet, header included,
/// in the session's protocol.
/// Grants: `packets` to run packet-mod callbacks; `wasi` separately enables the restricted WASI runtime.
interface packet-relay {
    /// The way a batch travels.
    enum direction { from-client, from-server }

    /// The upstream login's canonical player identity.
    record session-identity {
        display-name: string,
        xuid: string,
        uuid: string,
    }

    /// A resource pack the mod adds to the session.
    record session-pack {
        /// The pack's zip archive; its manifest identity must not repeat another pack in the stack.
        archive: list<u8>,
        /// Whether the pack applies above the server's packs rather than below them.
        above-server: bool,
    }

    /// Batch bodies the mod sends outside a relayed batch; an empty body sends nothing.
    record outbound {
        to-client: list<u8>,
        to-server: list<u8>,
    }
}

/// A trusted mod that relays every session packet. It needs the `packets` grant; WASI preview 2
/// is linked only with the `wasi` grant, without files, environment, arguments or network.
world packet-mod {
    use packet-relay.{direction, session-identity, session-pack, outbound};

    /// Begins a session: the upstream identity, the login client data as the session's Connect sent
    /// it (JSON), and the server's startup packets through StartGame as one batch body. Returns the
    /// resource packs the mod adds.
    export start: func(identity: session-identity, client-data: string, startup: list<u8>) -> result<list<session-pack>, string>;
    /// Handles one relayed batch: none forwards it unchanged; some replaces it, and an empty body
    /// drops it.
    export on-batch: func(direction: direction, batch: list<u8>) -> result<option<list<u8>>, string>;
    /// Runs timed work about once per client tick (50 ms) and returns packets to send now.
    export tick: func() -> result<outbound, string>;
    /// Ends the session.
    export stop: func();
}
