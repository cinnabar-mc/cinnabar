{
    "app-id": "io.github.cinnabar_mc.cinnabar",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.golang"],
    "command": "cinnabar",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=dri",
        "--device=input",
        "--filesystem=xdg-run/discord-ipc-0:ro",
        "--filesystem=xdg-run/discord-ipc-1:ro",
        "--filesystem=xdg-run/discord-ipc-2:ro",
        "--filesystem=xdg-run/discord-ipc-3:ro",
        "--filesystem=xdg-run/discord-ipc-4:ro",
        "--filesystem=xdg-run/discord-ipc-5:ro",
        "--filesystem=xdg-run/discord-ipc-6:ro",
        "--filesystem=xdg-run/discord-ipc-7:ro",
        "--filesystem=xdg-run/discord-ipc-8:ro",
        "--filesystem=xdg-run/discord-ipc-9:ro",
        "--filesystem=xdg-run/app/com.discordapp.Discord:ro",
        "--filesystem=xdg-run/snap.discord:ro",
        "--filesystem=xdg-run/snap.discord-canary:ro"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/golang/bin",
        "prepend-path": "/app/rust-toolchain/bin",
        "env": {
            "CARGO_BUILD_BUILD_DIR": "target",
            "CARGO_INCREMENTAL": "0",
            "GOTOOLCHAIN": "local",
            "GOWORK": "off",
            "GOPROXY": "off",
            "GOFLAGS": "-mod=vendor"
        }
    },
    "cleanup": ["/rust-toolchain"],
    "modules": [
        {
            "name": "cinnabar",
            "buildsystem": "simple",
            "build-commands": ["bash packaging/flatpak/build.sh"],
            "sources": [
                {"type": "archive", "path": "cinnabar-sources.tar.gz"}
            ]
        }
    ]
}
