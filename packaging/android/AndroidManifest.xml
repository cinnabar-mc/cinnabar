<?xml version="1.0" encoding="utf-8"?>
<!-- build-apk.sh fills the placeholders from runtime.json, Cargo.toml and the launcher product name. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@APPLICATION_ID@"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- For SignInHoldService only; granted at install, with no prompt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
    <application
        android:label="@PRODUCT_NAME@"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@style/StartupTheme">
        <profileable android:shell="@PROFILEABLE@" />
        <activity
            android:name=".BootstrapActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CinnabarActivity"
            android:windowSoftInputMode="adjustNothing"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|navigation">
            <meta-data android:name="android.app.lib_name" android:value="@CLIENT_LIBRARY@" />
        </activity>
        <!-- Keeps the game alive for up to three minutes while the player approves a Microsoft
             sign-in code in the browser. -->
        <service
            android:name=".SignInHoldService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
