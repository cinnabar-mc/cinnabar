<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v5 (Files element). Build via build-installer.ps1, which supplies Version, Payload, Icon,
     Scope and the install names and upgrade codes from release-assets.json. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- perUser installs without administrator approval. perMachine only updates installs made before
       per-user packages, under their original upgrade code; the updater then moves them per-user. -->
  <?if $(Scope) = "perUser" ?>
    <?define UpgradeCode = $(UserUpgradeCode) ?>
    <?define ShortcutKey = Software\Cinnabar\User ?>
  <?elseif $(Scope) = "perMachine" ?>
    <?define UpgradeCode = $(MachineUpgradeCode) ?>
    <?define ShortcutKey = Software\Cinnabar ?>
  <?else?>
    <?error Scope must be perUser or perMachine ?>
  <?endif?>
  <Package Name="Cinnabar" Manufacturer="Cinnabar" Version="$(Version)"
           UpgradeCode="$(UpgradeCode)" Scope="$(Scope)" Compressed="yes">
    <!-- Signed build ordering and explicit channel-switch consent are enforced by the updater. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="cinnabar.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="cinnabar.ico" />
    <!-- The update helper owns the client relaunch. -->
    <Property Id="MSIDISABLERMRESTART" Value="1" />

    <!-- A custom INSTALLFOLDER from the command line is kept, so upgrades stay in place. -->
    <Property Id="INSTALLFOLDER" Secure="yes" />

    <?if $(Scope) = "perUser" ?>
      <StandardDirectory Id="LocalAppDataFolder">
        <Directory Id="UserPrograms" Name="$(InstallParent)">
          <Directory Id="INSTALLFOLDER" Name="$(InstallFolder)" />
        </Directory>
      </StandardDirectory>
    <?else?>
      <StandardDirectory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="$(InstallFolder)" />
      </StandardDirectory>
    <?endif?>

    <!-- Each scope keys its shortcuts separately, so removing one product never breaks the other's. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopAppShortcut" Name="Cinnabar" Target="[INSTALLFOLDER]cinnabar.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="cinnabar.ico" />
        <RegistryValue Root="HKCU" Key="$(ShortcutKey)" Name="desktop-shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut" Name="Cinnabar" Target="[INSTALLFOLDER]cinnabar.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="cinnabar.ico" />
        <RegistryValue Root="HKCU" Key="$(ShortcutKey)" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Cinnabar" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(Payload)\**" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
